# Salin file ini jadi ".env" lalu isi tokennya
DISCORD_TOKEN=

# Opsional, buat hosting yang filenya suka ke-reset: ID channel privat tempat cadangan disimpan
# BACKUP_CHANNEL_ID=

# --- Musik (semuanya opsional, musik jalan tanpa ini) ---
# Spotify resmi (gratis di developer.spotify.com): playlist panjang dan lebih stabil
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Cookies YouTube (format cookies.txt) kalau hosting / VPS diblokir YouTube. Atau simpan sebagai data/cookies.txt
# YT_COOKIES=
# Pakai ffmpeg / yt-dlp sendiri (path lengkap). Kalau kosong, dipasang otomatis
# FFMPEG_PATH=
# YTDLP_PATH=
